  {
   "id": "hook",
   "type": "clip",
   "from": "aha",
   "offset": -1.0,
   "dur": 6.5,
   "title_hold": 2.4,
   "say": "In summer 2022, heat killed 61,672 people in Europe. Most were old, alone, at home.",
   "card": {
    "layout": "title",
    "kicker": "Calltree",
    "title": "Every name reached within the hour."
   }
  },
  {
   "id": "problem",
   "type": "card",
   "say": "Every city with a heat plan keeps a list of vulnerable residents. When the warning comes, staff phone them one by one. It takes two days, and the ones nobody reached are the ones who die.",
   "card": {
    "layout": "stat",
    "value": "2 days",
    "label": "A city's heat check-in today: a spreadsheet and a volunteer phone tree",
    "sub": "Half the people on French heat registers were hard to reach in 2025 (UNCCAS)"
   }
  },
  {
   "id": "ops",
   "type": "live",
   "say": "Meet Calltree. One click, and every name on the register gets a call, eight lines at a time. Pins turn green when residents are fine, amber when they need water or a fan, red when something is wrong. Every call ends with the quote that decided it.",
   "actions": [
    {
     "do": "wait",
     "for": "text=Declare heat drill",
     "timeout": 60000
    },
    {
     "do": "pause",
     "ms": 800
    },
    {
     "do": "click",
     "sel": "button:has-text('Declare heat drill')",
     "at": "click",
     "zoom": 1.5
    },
    {
     "do": "wait",
     "for": "text=Heat drill running",
     "timeout": 30000
    },
    {
     "do": "camera",
     "focus": "[aria-label^='Map of registered']",
     "zoom": 1.25,
     "at": "Pins"
    },
    {
     "do": "wait",
     "for": 32000,
     "timeout": 60000
    },
    {
     "do": "mark",
     "name": "aha"
    },
    {
     "do": "camera",
     "focus": "[aria-label='Completed calls, newest first']",
     "zoom": 1.35,
     "at": "quote"
    },
    {
     "do": "pause",
     "ms": 1400
    }
   ]
  },
  {
